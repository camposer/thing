[:find ?name ?ref ?src
 :where
 [?ns :ikp.namespace/service ?svc]
 [?svc :inventory.service/name ?name]
 (or-join [[?svc] ?ref]
   (and [?svc :inventory.service/ikpGBGF ?g] [?g :ikp.gbgf/name ?ref])
   (and [(missing? $ ?svc :inventory.service/ikpGBGF)] [(ground "<none>") ?ref])
   (and [?svc :inventory.service/ikpGBGF ?g2] [(missing? $ ?g2 :ikp.gbgf/name)] [(ground "<none>") ?ref]))
 (or-join [[?name] ?src]
   (and [?b :hsbc.ikp.attestation.service_bgi/service_name ?name] [?b :hsbc.ikp.attestation.service_bgi/bgi ?src])
   (and [?b2 :hsbc.ikp.attestation.service_bgi/service_name ?name] [(missing? $ ?b2 :hsbc.ikp.attestation.service_bgi/bgi)] [(ground "<none>") ?src])
   (and (not [_ :hsbc.ikp.attestation.service_bgi/service_name ?name]) [(ground "<no row>") ?src]))
 [(not= ?ref ?src)]
 [(not= ?src "<no row>")]          ; drop services missing from the upload
 [(not= ?ref "<none>")]            ; drop services with no B/GI on the ref
 [(not= ?src "<none>")]            ; drop services uploaded with a blank B/GI
 [(not= ?ref "WSIT Payments")]]    ; drop the gbgf2 Payments regrouping
