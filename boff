python3 -c '
import json, csv, sys

JSON_PATH = sys.argv[1]
CSV_PATH  = sys.argv[2]
JSON_KEY  = "eim_id"                 # field on each JSON org object (only some have it)
CSV_KEY   = "eim_id"                 # matching column in the CSV
CHECK_COL = "Business Unit Check"    # corrected value (yellow column)

# 1) build  eim_id -> corrected business unit  from the CSV
lookup = {}
with open(CSV_PATH, newline="", encoding="utf-8-sig") as f:
    for row in csv.DictReader(f):
        k = (row.get(CSV_KEY) or "").strip()
        v = (row.get(CHECK_COL) or "").strip()
        if k and v and v.upper() != "N/A":
            lookup[k] = v

# 2) patch the orgs in memory
with open(JSON_PATH, encoding="utf-8") as f:
    orgs = json.load(f)

changed = no_key = no_match = 0
for o in orgs:
    if JSON_KEY not in o or not str(o.get(JSON_KEY, "")).strip():
        no_key += 1                       # no eim_id -> leave as-is
        continue
    k = str(o[JSON_KEY]).strip()
    if k not in lookup:
        no_match += 1                     # eim_id present but not in CSV -> leave as-is
        continue
    if o.get("business_unit") != lookup[k]:
        o["business_unit"] = lookup[k]
        changed += 1

# 3) patched JSON -> stdout ; summary -> stderr
json.dump(orgs, sys.stdout, indent=2, ensure_ascii=False)
sys.stdout.write("\n")
print(f"Updated: {changed} | no eim_id: {no_key} | eim_id with no CSV match: {no_match}",
      file=sys.stderr)
' pcf_org_details.json business_unit_check.csv
